{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "preDeployCommand": [
      "bash -lc 'export FLASK_APP=backend.app:create_app && exec /opt/venv/bin/python scripts/migrate_deploy.py'"
    ],
    "startCommand": "bash start.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
